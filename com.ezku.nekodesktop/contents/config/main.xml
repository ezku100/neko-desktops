<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
    http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
<kcfgfile name=""/>

    <group name="General">
        <entry name="indicatorStyle" type="Enum">
            <label>Indicator style</label>
            <choices>
                <choice name="Caelestia"/>
                <choice name="Hyrulian"/>
                <choice name="Triforce"/>
                <choice name="Creeper"/>
                <choice name="Hearts"/>
                <choice name="Pokeball"/>
                <choice name="Pikachu"/>
                <choice name="Mario"/>
                <choice name="Dragonball"/>
                <choice name="Kirby"/>
                <choice name="Kitty"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="enableScroll" type="Bool">
            <label>Enable scroll to change desktop</label>
            <default>true</default>
        </entry>
        <entry name="scrollCyclic" type="Bool">
            <label>Cyclic scrolling</label>
            <default>false</default>
        </entry>
        <entry name="useSystemColors" type="Bool">
            <label>Use system colors</label>
            <default>true</default>
        </entry>
    </group>

    <group name="Caelestia">
        <entry name="caeActiveSize" type="Int"><label>Focused (pacman) size</label><default>18</default></entry>
        <entry name="caeOccupiedSize" type="Int"><label>Occupied size</label><default>10</default></entry>
        <entry name="caeEmptySize" type="Int"><label>Empty dot size</label><default>6</default></entry>
        <entry name="caeGap" type="Int"><label>Gap between indicators</label><default>2</default></entry>
        <entry name="caeMargin" type="Int"><label>Panel margin</label><default>2</default></entry>
        <entry name="caeMouthAngle" type="Int"><label>Pacman mouth angle</label><default>35</default></entry>
        <entry name="caeAnimate" type="Bool"><label>Animate pacman bite</label><default>true</default></entry>
        <entry name="caeShowGlyph" type="Bool"><label>Show ghost on occupied</label><default>true</default></entry>
        <entry name="caeActiveColor" type="String"><label>Focused color</label><default>#FFFFFF</default></entry>
        <entry name="caeOccupiedColor" type="String"><label>Occupied color</label><default>#FFFFFF</default></entry>
        <entry name="caeEmptyColor" type="String"><label>Empty color</label><default>#FFFFFF</default></entry>
        <entry name="caeEmptyOpacity" type="Int"><label>Empty opacity</label><default>40</default></entry>
    </group>

    <group name="Hyrulian">
        <entry name="hyrActiveSize" type="Int"><label>Sword size</label><default>20</default></entry>
        <entry name="hyrOccupiedSize" type="Int"><label>Rupee size</label><default>10</default></entry>
        <entry name="hyrEmptySize" type="Int"><label>Empty dot size</label><default>6</default></entry>
        <entry name="hyrGap" type="Int"><label>Gap between indicators</label><default>2</default></entry>
        <entry name="hyrMargin" type="Int"><label>Panel margin</label><default>2</default></entry>
        <entry name="hyrGlow" type="Bool"><label>Sword glow</label><default>true</default></entry>
        <entry name="hyrBladeColor" type="String"><label>Blade color</label><default>#E8E8E8</default></entry>
        <entry name="hyrGoldColor" type="String"><label>Gold color</label><default>#E8B800</default></entry>
        <entry name="hyrGripColor" type="String"><label>Grip color</label><default>#3B5BFD</default></entry>
        <entry name="hyrOccupiedColor" type="String"><label>Rupee color</label><default>#00E676</default></entry>
        <entry name="hyrEmptyColor" type="String"><label>Empty color</label><default>#FFFFFF</default></entry>
        <entry name="hyrEmptyOpacity" type="Int"><label>Empty opacity</label><default>40</default></entry>
    </group>

    <group name="Triforce">
        <entry name="triActiveSize" type="Int"><label>Triforce size</label><default>20</default></entry>
        <entry name="triOccupiedSize" type="Int"><label>Shard size</label><default>10</default></entry>
        <entry name="triEmptySize" type="Int"><label>Empty dot size</label><default>6</default></entry>
        <entry name="triGap" type="Int"><label>Gap between indicators</label><default>2</default></entry>
        <entry name="triMargin" type="Int"><label>Panel margin</label><default>2</default></entry>
        <entry name="triGlow" type="Bool"><label>Triforce glow</label><default>true</default></entry>
        <entry name="triActiveColor" type="String"><label>Triforce color</label><default>#FFFFFF</default></entry>
        <entry name="triOccupiedColor" type="String"><label>Shard color</label><default>#FFFFFF</default></entry>
        <entry name="triEmptyColor" type="String"><label>Empty color</label><default>#FFFFFF</default></entry>
        <entry name="triEmptyOpacity" type="Int"><label>Empty opacity</label><default>40</default></entry>
    </group>

    <group name="Creeper">
