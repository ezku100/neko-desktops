        <entry name="creSkinColor" type="String"><label>Creeper skin</label><default>#4CAF50</default></entry>
        <entry name="creFaceColor" type="String"><label>Creeper face</label><default>#141414</default></entry>
        <entry name="creTntColor" type="String"><label>TNT color</label><default>#E53935</default></entry>
        <entry name="creBandColor" type="String"><label>TNT band</label><default>#FFFFFF</default></entry>
        <entry name="creEmptyColor" type="String"><label>Empty color</label><default>#FFFFFF</default></entry>
        <entry name="creEmptyOpacity" type="Int"><label>Empty opacity</label><default>40</default></entry>
